<Window x:Class="AssettoApp.UI.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:AssettoApp.UI"
        xmlns:converters="clr-namespace:AssettoApp.UI.Converters"
        mc:Ignorable="d"
        Title="AssettoApp - Telemetry Analysis &amp; Setup Optimizer" 
        Height="700" Width="1000"
        WindowStartupLocation="CenterScreen"
        Background="#FF1E1E1E">
    
    <Window.Resources>
        <!-- Converters -->
        <converters:NullToBoolConverter x:Key="NullToBoolConverter"/>
        
        <!-- Modern dark theme styles -->
        <Style TargetType="TextBlock">
            <Setter Property="Foreground" Value="White"/>
            <Setter Property="FontSize" Value="13"/>
        </Style>
        
        <Style TargetType="ComboBox">
            <Setter Property="Height" Value="32"/>
            <Setter Property="FontSize" Value="13"/>
        </Style>
        
        <Style TargetType="Button">
            <Setter Property="Height" Value="36"/>
            <Setter Property="Background" Value="#FF0078D7"/>
            <Setter Property="Foreground" Value="White"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="FontSize" Value="13"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border Background="{TemplateBinding Background}" 
                                CornerRadius="4"
                                Padding="12,0">
                            <ContentPresenter HorizontalAlignment="Center" 
                                            VerticalAlignment="Center"/>
                        </Border>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
            <Style.Triggers>
                <Trigger Property="IsMouseOver" Value="True">
                    <Setter Property="Background" Value="#FF1E90FF"/>
                </Trigger>
                <Trigger Property="IsEnabled" Value="False">
                    <Setter Property="Background" Value="#FF404040"/>
                    <Setter Property="Foreground" Value="#FF808080"/>
                </Trigger>
            </Style.Triggers>
        </Style>
        
        <Style x:Key="SecondaryButton" TargetType="Button" BasedOn="{StaticResource {x:Type Button}}">
            <Setter Property="Background" Value="#FF2D2D30"/>
        </Style>
        
        <Style x:Key="DangerButton" TargetType="Button" BasedOn="{StaticResource {x:Type Button}}">
            <Setter Property="Background" Value="#FFD32F2F"/>
        </Style>
    </Window.Resources>
    
    <Grid Margin="20">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>
        
        <!-- Header -->
        <StackPanel Grid.Row="0" Margin="0,0,0,20">
            <TextBlock Text="AssettoApp" FontSize="32" FontWeight="Bold" Foreground="#FF0078D7"/>
            <TextBlock Text="Professional Telemetry Analysis &amp; Setup Optimization Tool" 
                      FontSize="14" Foreground="#FFAAAAAA" Margin="0,4,0,0"/>
        </StackPanel>
        
        <!-- Main Content -->
        <Grid Grid.Row="1">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="300"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>
            
            <!-- Left Panel - Configuration -->
            <Border Grid.Column="0" Background="#FF252526" CornerRadius="8" Padding="20" Margin="0,0,10,0">
                <StackPanel>
                    <TextBlock Text="CONFIGURATION" FontWeight="Bold" FontSize="14" Margin="0,0,0,15"/>
                    
                    <!-- Game Selection -->
                    <TextBlock Text="Game:" Margin="0,0,0,5"/>
                    <ComboBox ItemsSource="{Binding AvailableGames}" 
                             SelectedItem="{Binding SelectedGame}"
                             Margin="0,0,0,15"/>
                    
                    <!-- Car Selection -->
                    <TextBlock Text="Car:" Margin="0,0,0,5"/>
                    <ComboBox ItemsSource="{Binding AvailableCars}" 
                             SelectedItem="{Binding SelectedCar}"
                             Margin="0,0,0,15"/>
                    
                    <!-- Track Selection -->
                    <TextBlock Text="Track:" Margin="0,0,0,5"/>
                    <ComboBox ItemsSource="{Binding AvailableTracks}" 
                             SelectedItem="{Binding SelectedTrack}"
                             Margin="0,0,0,20"/>
                    
                    <Separator Margin="0,10" Background="#FF3F3F46"/>
                    
                    <!-- Connection -->
                    <TextBlock Text="CONNECTION" FontWeight="Bold" FontSize="14" Margin="0,10,0,15"/>
                    <Button Content="Connect to Simulator" 
                           Command="{Binding ConnectCommand}"
                           Margin="0,0,0,10"/>
                    
                    <StackPanel Orientation="Horizontal" Margin="0,0,0,20">
                        <Ellipse Width="12" Height="12" Margin="0,0,8,0">
                            <Ellipse.Style>
                                <Style TargetType="Ellipse">
                                    <Setter Property="Fill" Value="#FFDC3545"/>
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding IsConnected}" Value="True">
                                            <Setter Property="Fill" Value="#FF28A745"/>
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </Ellipse.Style>
                        </Ellipse>
                        <TextBlock>
                            <TextBlock.Style>
                                <Style TargetType="TextBlock">
                                    <Setter Property="Text" Value="Status: Disconnected"/>
                                    <Setter Property="Foreground" Value="White"/>
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding IsConnected}" Value="True">
                                            <Setter Property="Text" Value="Status: Connected"/>
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </TextBlock.Style>
                        </TextBlock>
                    </StackPanel>
                    
                    <Separator Margin="0,10" Background="#FF3F3F46"/>
                    
                    <!-- Recording Controls -->
                    <TextBlock Text="DATA RECORDING" FontWeight="Bold" FontSize="14" Margin="0,10,0,15"/>
                    <Button Content="Start Recording" 
                           Command="{Binding StartRecordingCommand}"
                           Margin="0,0,0,10"/>
                    <Button Content="Stop Recording" 
                           Command="{Binding StopRecordingCommand}"
                           Style="{StaticResource DangerButton}"
                           Margin="0,0,0,20"/>
                </StackPanel>
            </Border>
            
            <!-- Right Panel - Actions and Results -->
            <Border Grid.Column="1" Background="#FF252526" CornerRadius="8" Padding="20" Margin="10,0,0,0">
                <StackPanel>
                    <TextBlock Text="ANALYSIS &amp; SETUP GENERATION" FontWeight="Bold" FontSize="14" Margin="0,0,0,20"/>
                    
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>
                        
                        <Button Grid.Column="0" Content="Analyze Session" 
                               Command="{Binding AnalyzeSessionCommand}"
                               Margin="0,0,5,0"/>
                        
                        <Button Grid.Column="1" Content="Generate Setup" 
                               Command="{Binding GenerateSetupCommand}"
                               Margin="5,0,5,0"/>
                        
                        <Button Grid.Column="2" Content="Export Setup" 
                               Command="{Binding ExportSetupCommand}"
                               Margin="5,0,0,0"/>
                    </Grid>
                    
                    <Separator Margin="0,25" Background="#FF3F3F46"/>
                    
                    <!-- Results Display -->
                    <TextBlock Text="ANALYSIS RESULTS" FontWeight="Bold" FontSize="14" Margin="0,0,0,15"/>
                    
                    <ScrollViewer VerticalScrollBarVisibility="Auto" Height="380">
                        <StackPanel>
                            <Border Background="#FF1E1E1E" CornerRadius="4" Padding="15" Margin="0,0,0,10">
                                <Border.Style>
                                    <Style TargetType="Border">
                                        <Setter Property="Visibility" Value="Collapsed"/>
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding LastAnalysis, Converter={StaticResource NullToBoolConverter}}" Value="True">
                                                <Setter Property="Visibility" Value="Visible"/>
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </Border.Style>
                                <StackPanel>
                                    <TextBlock Text="Driving Style" FontWeight="SemiBold" Foreground="#FF0078D7" Margin="0,0,0,5"/>
                                    <TextBlock Text="{Binding LastAnalysis.DrivingStyle}" FontSize="16" Margin="0,0,0,15"/>
                                    
                                    <TextBlock Text="Track Conditions" FontWeight="SemiBold" Foreground="#FF0078D7" Margin="0,0,0,5"/>
                                    <TextBlock Margin="0,0,0,3">
                                        <Run Text="Track Temperature: "/>
                                        <Run Text="{Binding LastAnalysis.TrackConditions.AverageTrackTemp, StringFormat='{}{0:F1}°C'}" FontWeight="SemiBold"/>
                                    </TextBlock>
                                    <TextBlock Margin="0,0,0,3">
                                        <Run Text="Air Temperature: "/>
                                        <Run Text="{Binding LastAnalysis.TrackConditions.AverageAirTemp, StringFormat='{}{0:F1}°C'}" FontWeight="SemiBold"/>
                                    </TextBlock>
                                    <TextBlock Margin="0,0,0,15">
                                        <Run Text="Grip Level: "/>
                                        <Run Text="{Binding LastAnalysis.TrackConditions.AverageGrip, StringFormat='{}{0:P0}'}" FontWeight="SemiBold"/>
                                    </TextBlock>
                                    
                                    <TextBlock Text="Balance Analysis" FontWeight="SemiBold" Foreground="#FF0078D7" Margin="0,0,0,5"/>
                                    <TextBlock Margin="0,0,0,3">
                                        <Run Text="Oversteer Corners: "/>
                                        <Run Text="{Binding LastAnalysis.BalanceAnalysis.OversteerCornerCount}" FontWeight="SemiBold"/>
                                    </TextBlock>
                                    <TextBlock Margin="0,0,0,3">
                                        <Run Text="Understeer Corners: "/>
                                        <Run Text="{Binding LastAnalysis.BalanceAnalysis.UndersteerCornerCount}" FontWeight="SemiBold"/>
                                    </TextBlock>
                                </StackPanel>
                            </Border>
                            
                            <TextBlock Text="No analysis results yet. Record a session and click 'Analyze Session'." 
                                      Foreground="#FFAAAAAA" TextWrapping="Wrap">
                                <TextBlock.Style>
                                    <Style TargetType="TextBlock">
                                        <Setter Property="Visibility" Value="Visible"/>
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding LastAnalysis, Converter={StaticResource NullToBoolConverter}}" Value="True">
                                                <Setter Property="Visibility" Value="Collapsed"/>
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </TextBlock.Style>
                            </TextBlock>
                        </StackPanel>
                    </ScrollViewer>
                </StackPanel>
            </Border>
        </Grid>
        
        <!-- Status Bar -->
        <Border Grid.Row="2" Background="#FF007ACC" CornerRadius="4" Padding="12,8" Margin="0,20,0,0">
            <TextBlock Text="{Binding StatusMessage}" FontWeight="SemiBold"/>
        </Border>
    </Grid>
</Window>

<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net8.0-windows</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <UseWPF>true</UseWPF>
    <EnableWindowsTargeting>true</EnableWindowsTargeting>
    
    <!-- Application Info -->
    <AssemblyName>AssettoApp</AssemblyName>
    <Product>AssettoApp - Telemetry Analysis &amp; Setup Optimizer</Product>
    <Version>1.0.0</Version>
    <AssemblyVersion>1.0.0.0</AssemblyVersion>
    <FileVersion>1.0.0.0</FileVersion>
    <Copyright>Copyright © 2024 Thomas Rizzo</Copyright>
    <Description>Professional telemetry analysis and setup optimization tool for Assetto Corsa and Assetto Corsa EVO</Description>
    
    <!-- Build Options -->
    <PublishReadyToRun>true</PublishReadyToRun>
    <TieredCompilation>true</TieredCompilation>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="LiveCharts.Wpf" Version="0.9.7" />
    <PackageReference Include="Microsoft.Extensions.DependencyInjection" Version="8.0.0" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\AssettoApp.Core\AssettoApp.Core.csproj" />
    <ProjectReference Include="..\AssettoApp.SimulatorIntegration\AssettoApp.SimulatorIntegration.csproj" />
    <ProjectReference Include="..\AssettoApp.TelemetryAnalysis\AssettoApp.TelemetryAnalysis.csproj" />
    <ProjectReference Include="..\AssettoApp.SetupGeneration\AssettoApp.SetupGeneration.csproj" />
  </ItemGroup>

</Project>
